# /etc/biowatch/jobs.env — root:root 600, lu par systemd (EnvironmentFile=).
# Posé par infra/vps/50-jobs-deploy.sh s'il n'existe pas ; à compléter À LA MAIN
# sur le VPS. Ne jamais commiter le vrai fichier, ne jamais le mettre dans GitHub.

BIOWATCH_ENV=prod
# Le code déployé (/opt/biowatch) est en lecture seule pour biowatch-jobs.
BIOWATCH_DATA_ROOT=/var/lib/biowatch/jobs
LOG_LEVEL=INFO

# Base prod (#23). Le nom DOIT finir par _prod, sinon refus de connexion (ADR-003).
POSTGRES_USER=biowatch_jobs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=biowatch_prod
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
