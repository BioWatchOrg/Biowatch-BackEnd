# /etc/biowatch/jobs.env — root:root 600, lu par systemd (EnvironmentFile=).
# Posé par infra/vps/60-jobs-deploy.sh s'il n'existe pas, jamais réécrit ensuite.
# Ne jamais commiter le vrai fichier, ne jamais le mettre dans GitHub.
#
# Réglages des jobs uniquement. Les identifiants de la base (POSTGRES_*) sont
# dans /etc/biowatch/db-jobs.env, posé par 55-postgres.sh (#23) et lu APRÈS ce
# fichier : ne pas les dupliquer ici, ils seraient écrasés. Pas de DATABASE_URL
# non plus : elle primerait sur les POSTGRES_* de db-jobs.env.

BIOWATCH_ENV=prod
# Le code déployé (/opt/biowatch) est en lecture seule pour biowatch-jobs.
BIOWATCH_DATA_ROOT=/var/lib/biowatch/jobs
LOG_LEVEL=INFO

# Import OSM (#35) : snapshots .pbf téléchargés ici, supprimés après chaque import.
OSM_DATA_DIR=/var/lib/biowatch/jobs/osm
# OSM2PGSQL_BIN=/usr/bin/osm2pgsql
