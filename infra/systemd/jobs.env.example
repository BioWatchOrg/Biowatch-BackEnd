# /etc/biowatch/jobs.env — root:root 600, lu par systemd (EnvironmentFile).
# Ne jamais commiter le vrai fichier.

# Environnement des jobs (#18) : prod sur le VPS, jamais de flag --env par job.
BIOWATCH_ENV=prod
DATABASE_URL=postgresql+psycopg://biowatch_jobs:...@127.0.0.1:5432/biowatch_prod
LOG_LEVEL=INFO

# Import OSM (#35)
OSM_DATA_DIR=/var/lib/biowatch/jobs/osm
# OSM2PGSQL_BIN=/usr/bin/osm2pgsql
