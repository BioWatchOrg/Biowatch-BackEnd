# /etc/biowatch/jobs.env — root:root 600, lu par systemd (EnvironmentFile).
# Ne jamais commiter le vrai fichier.

DATABASE_URL=postgresql+psycopg://biowatch_jobs:...@127.0.0.1:5432/biowatch_prod
LOG_LEVEL=INFO

# Import OSM (#35)
OSM_DATA_DIR=/var/lib/biowatch/jobs/osm
# OSM2PGSQL_BIN=/usr/bin/osm2pgsql

# Signal SQS « import terminé » — désactivé tant que BioWatch n'a pas de compte AWS.
# Le renseigner suffit à l'activer (aucun changement de code).
# OSM_IMPORT_DONE_QUEUE_URL=https://sqs.eu-west-3.amazonaws.com/<account>/osm_import_done
# AWS_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
