#!/usr/bin/env bash
# biowatch-ci-deploy — commande forcée de la clé SSH de la CI (#27).
#
# C'est la SEULE chose que la clé de la CI peut exécuter sur le VPS
# (authorized_keys : restrict,command="…"). La commande demandée par le client
# arrive dans SSH_ORIGINAL_COMMAND et n'est jamais évaluée par un shell :
# elle est découpée en mots puis confrontée à une liste fermée.
#
#   deploy <sha>       archive tar.gz sur stdin → construit, active, timers, purge
#   rollback [<sha>]   réactive une release déjà construite, puis ses timers
#   status             release active, releases disponibles, timers
#
# Depuis une session membre sur le VPS (mêmes droits que la CI) :
#   sudo -u biowatch-ci /usr/local/sbin/biowatch-ci-deploy rollback [<sha>]
#
# Installé par infra/vps/50-jobs-deploy.sh, qui remplace les @…@.

set -Eeuo pipefail
umask 077

readonly DEPLOY_ACCOUNT="@DEPLOY_ACCOUNT@"
readonly RELEASE_BIN="@SBIN_DIR@/biowatch-release"
readonly INSTALL_TIMERS_BIN="@SBIN_DIR@/biowatch-install-timers"
readonly LOCK_FILE="@CI_HOME@/deploy.lock"

log() {
  printf '%s [deploy] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >&2
  # Trace aussi dans le journal du VPS : journalctl -t biowatch-deploy
  logger -t biowatch-deploy -- "$*" 2>/dev/null || true
}
die() { log "ERREUR : $*"; exit 1; }

[[ "$DEPLOY_ACCOUNT" != @* ]] || die "script non installé (lancer infra/vps/50-jobs-deploy.sh)"

# `read -a` découpe sur les blancs sans glob ni expansion : « deploy $(rm …) »
# donne trois mots, refusés plus bas, jamais exécutés.
if [[ -n "${SSH_ORIGINAL_COMMAND:-}" ]]; then
  read -r -a argv <<<"$SSH_ORIGINAL_COMMAND"
else
  argv=("$@")
fi
verb="${argv[0]:-}"
sha="${argv[1]:-}"
(( ${#argv[@]} <= 2 )) || die "trop d'arguments"

check_sha() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]] || die "SHA invalide : 40 caractères hexadécimaux attendus"
}

release() { sudo -n -u "$DEPLOY_ACCOUNT" "$RELEASE_BIN" "$@"; }

# Le manifeste est produit par la release active (deploy), puis lu et
# revalidé par root. pipefail : un manifeste en échec n'installe rien.
sync_timers() { release manifest | sudo -n "$INSTALL_TIMERS_BIN"; }

# Un déploiement à la fois, qu'il vienne de la CI ou d'un membre.
exec 9>"$LOCK_FILE"
flock -w 900 9 || die "un autre déploiement est en cours depuis plus de 15 min"

case "$verb" in
  deploy)
    check_sha "$sha"
    log "déploiement de ${sha}"
    release stage "$sha"
    release activate "$sha"
    sync_timers
    release prune
    log "déploiement de ${sha} terminé"
    ;;
  rollback)
    [[ -z "$sha" ]] || check_sha "$sha"
    # stdin n'est pas lu : une archive envoyée par erreur est ignorée.
    release rollback ${sha:+"$sha"} </dev/null
    sync_timers
    log "retour arrière terminé"
    ;;
  status)
    [[ -z "$sha" ]] || die "status ne prend pas d'argument"
    release status </dev/null
    systemctl list-timers --all --no-pager 'biowatch-job@*'
    ;;
  *)
    die "commande refusée — attendu : deploy <sha> | rollback [<sha>] | status"
    ;;
esac
