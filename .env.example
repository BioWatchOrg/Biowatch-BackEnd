# Secrets d'outillage, communs à tous les environnements.
#   cp .env.example .env
#
# Ce fichier ne contient AUCUNE config applicative : la config par
# environnement vit dans .env.dev / .env.prod (voir .env.dev.example).

# Lecture des tâches Notion par le serveur MCP `biowatch-notion`.
NOTION_TOKEN=secret_...
# Écriture de la documentation technique dans Notion (même serveur MCP).
NOTION_TOKEN_DOC=secret_...
