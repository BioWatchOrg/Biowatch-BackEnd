POSTGRES_PASSWORD=...
POSTGRES_USER=...
POSTGRES_DB=...

# Optional: Notion Token is used to fecth documents from Notion by Claude Code custom mcp
NOTION_TOKEN=...
# Optional: Notion Token is used to add documents to Notion by Claude Code custom mcp
NOTION_TOKEN_DOC=...

# Host/port used by the ORM to reach PostgreSQL (defaults: 127.0.0.1:5432).
# In dev, point these at your SSH tunnel to the VPS.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional: full SQLAlchemy URL. When set, it overrides the POSTGRES_* variables above.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/biowatch_dev

# Backend log level (DEBUG/INFO/WARNING/ERROR). Defaults to INFO (prod).
# In dev, set DEBUG or pass `--debug` to the jobs CLI.
LOG_LEVEL=INFO

# OSM import (#35): where .pbf snapshots are downloaded (deleted after each import).
# OSM_DATA_DIR=data/osm
# Optional: osm2pgsql binary to use (default: `osm2pgsql` from PATH).
# OSM2PGSQL_BIN=/usr/bin/osm2pgsql
# Optional: SQS "import done" signal. Unset = disabled (BioWatch has no AWS account yet).
# OSM_IMPORT_DONE_QUEUE_URL=https://sqs.eu-west-3.amazonaws.com/<account>/osm_import_done
# AWS_REGION=eu-west-3
