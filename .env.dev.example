# Config applicative de l'environnement DEV.
#   cp .env.dev.example .env.dev
#
# Chargé quand BIOWATCH_ENV=dev ou `--env dev` — qui est le DÉFAUT.
# Ne doit jamais contenir de secret de production.
#
# L'équivalent prod (.env.prod) n'existe QUE sur le VPS : c'est précisément
# son absence en local qui empêche un `--env prod` accidentel d'aboutir.

# PostgreSQL + PostGIS local :
#   docker compose -f infra/docker/docker-compose.yml up -d postgis
POSTGRES_USER=biowatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=biowatch_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optionnel : URL SQLAlchemy complète. Si définie, elle prime sur les POSTGRES_* ci-dessus.
# DATABASE_URL=postgresql+psycopg://biowatch:change-me@127.0.0.1:5432/biowatch_dev

# Niveau de log (DEBUG/INFO/WARNING/ERROR).
LOG_LEVEL=DEBUG
